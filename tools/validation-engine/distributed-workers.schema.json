{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seerrng.dev/schemas/distributed-workers-v1.json",
  "title": "SeerrNG distributed validation workers",
  "description": "Secret-free controller inventory for authenticated distributed validation workers.",
  "$comment": "Runtime validation additionally enforces a 131072-byte normalized UTF-8 document limit, canonical NFC text, distinct worker IDs/addresses/identity fingerprints, a controllerId distinct from every worker ID, and a non-null controllerWorkerId that references an enabled worker; those document-level, cross-item, and canonical-text constraints are not expressible here without non-standard extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "controllerId",
    "controllerWorkerId",
    "workers"
  ],
  "properties": {
    "schema": {
      "const": "seerrng-distributed-worker-config/v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "controllerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "controllerWorkerId": {
      "description": "Optional worker process hosted on the controller machine. This worker ID remains distinct from controllerId and must reference an enabled worker.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      ]
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/worker"
      }
    }
  },
  "$defs": {
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "address", "enabled", "identitySha256", "n"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "address": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://[a-z0-9_\\[\\]:.-]+$",
          "allOf": [
            {
              "not": {
                "pattern": "^https://0\\.0\\.0\\.0(?::[0-9]+)?$"
              }
            },
            {
              "not": {
                "pattern": "^https://\\[::\\](?::[0-9]+)?$"
              }
            },
            {
              "not": {
                "pattern": "\\.(?::[0-9]+)?$"
              }
            },
            {
              "not": {
                "pattern": ":(?:0|443)$"
              }
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "identitySha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 fingerprint of public worker identity material; never a secret or private key."
        },
        "n": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          ]
        }
      }
    }
  }
}
